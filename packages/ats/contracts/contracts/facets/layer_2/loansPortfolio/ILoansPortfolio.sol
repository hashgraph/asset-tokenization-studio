pragma solidity >=0.8.0 <0.9.0;

/// @custom:hash resolverKey LoansPortfolio
bytes32 constant RESOLVER_KEY_LOANS_PORTFOLIO = 0x3f6ea14bbeaea82befb49409b874caf151715c6619ac1d26ba858039b7ece33e;

/// @title ILoansPortfolio
/// @author Asset Tokenization Studio Team
/// @notice External interface for the loans-portfolio facet: registration of holdings,
///         withdrawals and read-only metrics over the portfolio composition.
interface ILoansPortfolio {
    /// @notice High-level categorisation of how the portfolio evolves over its lifetime.
    enum PortfolioType {
        NONE,
        STATIC,
        REVOLVING,
        MANAGED,
        OPEN,
        CLOSED
    }

    /// @notice Strategy used to forward cash flows generated by holdings to investors.
    enum DistributionPolicy {
        NONE,
        DIRECT_PASSTHROUGH,
        ACCRUED
    }

    /// @notice Supported underlying asset categories backing a portfolio entry.
    enum HoldingsAssetType {
        NONE,
        LOAN,
        CASH
    }

    /// @notice Tuple describing one underlying holding tracked by the portfolio.
    /// @dev `assetAddress` is the on-chain handle of the loan or cash token.
    struct HoldingsAsset {
        address assetAddress;
        HoldingsAssetType holdingsAssetType;
    }

    /// @notice Portfolio-level configuration captured at initialisation.
    struct LoansPortfolioDetailsData {
        PortfolioType portfolioType;
        DistributionPolicy distributionPolicy;
    }

    /// @notice Emitted once when the LoansPortfolio capability is initialised on a token.
    /// @dev Fires exclusively from `initializeLoansPortfolio` after the storage write succeeds.
    event LoansPortfolioInitialized(LoansPortfolioDetailsData loansPortfolioData);

    /// @notice Emitted when a new holdings asset is added to the portfolio.
    /// @param holdingsAsset The asset descriptor that was registered.
    event HoldingsAssetAdded(HoldingsAsset holdingsAsset);

    /// @notice Emitted when an existing holdings asset is removed from the portfolio.
    /// @param holdingsAsset The asset descriptor that was removed.
    event HoldingsAssetRemoved(HoldingsAsset holdingsAsset);

    /// @notice Emitted when a registered loan holdings asset notifies a state update.
    /// @param loanHoldingsAsset Address of the loan whose state was advertised.
    event LoanHoldingsAssetUpdated(address loanHoldingsAsset);

    /// @notice Emitted when funds are withdrawn from a holdings asset to an external account.
    /// @param assetAddress Address of the holdings asset funds were drawn from.
    /// @param to           Recipient of the withdrawn amount.
    /// @param amount       Amount transferred to the recipient.
    event LoansPortfolioWithdrawn(address assetAddress, address to, uint256 amount);

    /// @notice Thrown when adding a holdings asset that is already registered.
    /// @param assetAddress Address of the asset that is already present.
    error HoldingsAssetAlreadyExists(address assetAddress);

    /// @notice Thrown when looking up a holdings asset that has not been registered.
    /// @param assetAddress Address of the asset that was not found.
    error HoldingAssetNotFound(address assetAddress);

    /// @notice Thrown when a holdings asset declares a type outside the supported set.
    /// @param holdingsAssetType The unsupported `HoldingsAssetType` value (as `uint8`).
    error HoldingsAssetTypeNotSupported(uint8 holdingsAssetType);

    /// @notice One-shot initialiser for the loans-portfolio facet.
    /// @dev Populates the portfolio configuration alongside the security-level regulation
    ///      and additional security metadata; intended to be called exactly once per token.
    /// @param _loansPortfolioData     Portfolio-level configuration (type, distribution policy).
    function initializeLoansPortfolio(ILoansPortfolio.LoansPortfolioDetailsData calldata _loansPortfolioData) external;

    /// @notice Registers a new holdings asset within the portfolio.
    /// @param _holdingsAsset Descriptor of the asset being added.
    /// @return success_ True when the asset was newly registered.
    function addHoldingsAsset(HoldingsAsset memory _holdingsAsset) external returns (bool success_);

    /// @notice Removes a previously registered holdings asset.
    /// @param _holdingsAsset Descriptor of the asset being removed.
    /// @return success_ True when the asset was effectively removed.
    function removeHoldingsAsset(HoldingsAsset memory _holdingsAsset) external returns (bool success_);

    /// @notice Broadcasts that the loan holdings asset's state has changed off-portfolio.
    /// @dev Pure notification path — does not mutate the underlying loan; merely emits
    ///      `LoanHoldingsAssetUpdated` so indexers refresh their view.
    /// @param _holdingsAssetAddress Address of the loan holdings asset that was updated.
    /// @return success_ True when the notification was accepted.
    function notifyLoanHoldingsAssetUpdate(address _holdingsAssetAddress) external returns (bool success_);

    /// @notice Withdraws an amount from a holdings asset to an external recipient.
    /// @param _assetAddress Holdings asset funds are drawn from.
    /// @param _to           Recipient of the withdrawn amount.
    /// @param _amount       Amount to withdraw.
    /// @return success_ True when the withdrawal completed.
    function loansPortfolioWithdraw(
        address _assetAddress,
        address _to,
        uint256 _amount
    ) external returns (bool success_);

    /// @notice Returns the portfolio-level configuration captured at initialisation.
    /// @return loansPortfolioData_ The persisted portfolio configuration.
    function getLoansPortfolioData() external view returns (LoansPortfolioDetailsData memory loansPortfolioData_);

    /// @notice Returns a paginated slice of every registered holdings asset address.
    /// @param _pageIndex  Zero-based page index.
    /// @param _pageLength Number of entries per page.
    /// @return assets_ Slice of asset addresses for the requested page.
    function getHoldingsAssets(
        uint256 _pageIndex,
        uint256 _pageLength
    ) external view returns (address[] memory assets_);

    /// @notice Returns a paginated slice of holdings assets whose type is `LOAN`.
    /// @param _pageIndex  Zero-based page index.
    /// @param _pageLength Number of entries per page.
    /// @return assets_ Slice of loan-holdings addresses for the requested page.
    function getLoanHoldingsAssets(
        uint256 _pageIndex,
        uint256 _pageLength
    ) external view returns (address[] memory assets_);

    /// @notice Returns a paginated slice of holdings assets paired with the portfolio's
    ///         current balance in each.
    /// @param _pageIndex  Zero-based page index.
    /// @param _pageLength Number of entries per page.
    /// @return assets_   Slice of asset addresses for the requested page.
    /// @return balances_ Balances held by the portfolio for each entry in `assets_`.
    function getHoldingsAssetOwnership(
        uint256 _pageIndex,
        uint256 _pageLength
    ) external view returns (address[] memory assets_, uint256[] memory balances_);

    /// @notice Returns the total number of registered holdings assets.
    /// @return numberOfAssets_ Count of holdings assets.
    function getNumberOfAssets() external view returns (uint256 numberOfAssets_);

    /// @notice Returns the count of holdings assets with type `LOAN`.
    /// @return numberOfLoans_ Count of loan holdings.
    function getNumberOfLoans() external view returns (uint256 numberOfLoans_);

    /// @notice Returns the count of holdings assets with type `CASH`.
    /// @return numberOfCash_ Count of cash holdings.
    function getNumberOfCash() external view returns (uint256 numberOfCash_);

    /// @notice Returns the count of loan holdings currently classified as performing.
    /// @return numberOfPerformingLoans_ Count of performing loans.
    function getNumberOfPerformingLoans() external view returns (uint256 numberOfPerformingLoans_);

    /// @notice Returns the count of loan holdings currently classified as non-performing.
    /// @return numberOfNonPerformingLoans_ Count of non-performing loans.
    function getNumberOfNonPerformingLoans() external view returns (uint256 numberOfNonPerformingLoans_);

    /// @notice Returns the count of loan holdings currently in default.
    /// @return numberDefaultedLoans_ Count of defaulted loans.
    function getNumberDefaultedLoans() external view returns (uint256 numberDefaultedLoans_);

    /// @notice Returns the secured-loans ratio as a numerator/denominator pair.
    /// @dev Pair semantics avoid loss-of-precision compared to a single fixed-point value.
    /// @return numerator_   Numerator of the secured-loans ratio.
    /// @return denominator_ Denominator of the secured-loans ratio.
    function getSecuredLoansRatio() external view returns (uint256 numerator_, uint256 denominator_);

    /// @notice Returns the performing-loans ratio as a numerator/denominator pair.
    /// @return numerator_   Numerator of the performing-loans ratio.
    /// @return denominator_ Denominator of the performing-loans ratio.
    function getPerformingLoansRatio() external view returns (uint256 numerator_, uint256 denominator_);

    /// @notice Returns the non-performing-loans ratio as a numerator/denominator pair.
    /// @return numerator_   Numerator of the non-performing-loans ratio.
    /// @return denominator_ Denominator of the non-performing-loans ratio.
    function getNonPerformingLoansRatio() external view returns (uint256 numerator_, uint256 denominator_);

    /// @notice Returns the defaulted-loans ratio as a numerator/denominator pair.
    /// @return numerator_   Numerator of the defaulted-loans ratio.
    /// @return denominator_ Denominator of the defaulted-loans ratio.
    function getDefaultedLoansRatio() external view returns (uint256 numerator_, uint256 denominator_);
}
